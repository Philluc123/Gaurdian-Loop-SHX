# Copy to .env and fill in. Never commit the real .env.

# Call ingestion (Workstream A)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# STT adapters (Workstream A) - set STT_PROVIDER to whichever is under test
STT_PROVIDER=elevenlabs # elevenlabs | deepgram | azure
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# LLM classifier (Workstream C)
GEMINI_API_KEY=

# Event store (Workstream E)
MONGODB_URI=mongodb://localhost:27017/guardian-loop

# Alerts (Workstream E)
GUARDIAN_ALERT_FROM_NUMBER=

# Server
PORT=3000
DASHBOARD_WS_PATH=/ws/dashboard
