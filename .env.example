# Copy to .env in the REPO ROOT and fill in. Never commit the real .env.
# Put comments on their own lines, not after a value.
# Share real values with teammates through a password manager or DM, not git.

# Server
PORT=3000
DASHBOARD_WS_PATH=/ws/dashboard
# Public https:// origin of this server, no trailing slash. Used twice:
#   - the call page: getUserMedia needs a secure context, so a second laptop or a
#     phone on your LAN over plain http has its microphone blocked. Start a tunnel:
#       cloudflared tunnel --url http://localhost:3000
#   - alerts (Workstream E): the live-view link in the guardian's notification.
PUBLIC_BASE_URL=

# Call ingestion - browser WebRTC (Workstream A)
# Shared secret required to join a call room. The tunnel URL is public, so without
# this anyone who finds it can join.
WEBRTC_ROOM_SECRET=
# Capture format. pcm16 @ 16000 is the default and sounds better; mulaw forces 8000
# to mimic a phone codec, which is worth checking since real scam calls arrive that way.
WEBRTC_ENCODING=pcm16
WEBRTC_SAMPLE_RATE=16000
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302

# Speaker-attribution gate. Both participants are in one room, so each mic hears both
# people; this silences the quieter track while the other clearly dominates.
# Tune these in the actual demo room - the right values depend on its noise floor.
WEBRTC_GATE=true
WEBRTC_GATE_DOMINANCE_DB=9
WEBRTC_GATE_HANGOVER_MS=300
WEBRTC_GATE_FLOOR_DBFS=-50

# Guardian who receives alerts (hard-coded for the demo)
GUARDIAN_NAME=
# The notification provider uses this to reach the guardian's device (section 3.7).
GUARDIAN_PHONE=

# Speech-to-text (Workstream A) - Deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# LLM classifier (Workstream C)
GEMINI_API_KEY=
# Optional model override.
GEMINI_MODEL=gemini-3.5-flash-lite
# Seconds of new speech with no LLM call before a heartbeat call. The heartbeat is
# what catches scams that never say a rule keyword, so keep it short.
LLM_HEARTBEAT_SEC=15

# Event store (Workstream E)
MONGODB_URI=mongodb://localhost:27017/guardian-loop

# Dev transcript sink (temporary, until the event store lands)
# TRANSCRIPT_LOG=0 disables it; TRANSCRIPT_LOG_DIR changes where files go.
TRANSCRIPT_LOG_DIR=logs/calls
