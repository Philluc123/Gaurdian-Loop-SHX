# Copy to .env and fill in. Never commit the real .env.

# STT adapters (Workstream A) - set STT_PROVIDER to whichever is under test
STT_PROVIDER=elevenlabs # elevenlabs | deepgram | azure
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# LLM classifier (Workstream C)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite # optional override

# Event store (Workstream E)
MONGODB_URI=mongodb://localhost:27017/guardian-loop

# Alerts (Workstream E)
PUBLIC_BASE_URL= # e.g. https://guardian.example.com, used for the notification's live-view link

# Server
PORT=3000
DASHBOARD_WS_PATH=/ws/dashboard
