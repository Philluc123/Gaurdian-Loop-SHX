{
  "name": "guardian-loop-shx",
  "private": true,
  "version": "0.1.0",
  "description": "Guardian Loop: real-time scam-call detection and guardian alerting (ShellHacks)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run dev --workspace=@guardian-loop/server",
    "replay": "tsx scripts/replay.ts",
    "make-audio": "tsx scripts/make-fixture-audio.ts",
    "fake-call": "tsx scripts/fake-webrtc.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.5.0"
  }
}
